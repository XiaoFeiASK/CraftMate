{
  "name": "craftmate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:desktop": "npm run dev -w @craftmate/desktop",
    "dev:orchestrator": "npm run dev -w @craftmate/orchestrator",
    "dev:console": "npm run dev -w @craftmate/console",
    "build": "npm run build -w @craftmate/console",
    "build:console": "npm run build -w @craftmate/console",
    "build:desktop": "npm run build -w @craftmate/desktop",
    "test": "node --test --experimental-strip-types \"packages/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
