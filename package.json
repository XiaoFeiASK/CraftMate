{
  "name": "craftmate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:desktop": "npm run dev -w @craftmate/desktop-shell",
    "dev:orchestrator": "npm run dev -w @craftmate/orchestrator",
    "dev:ingress": "npm run dev -w @craftmate/ingress",
    "dev:voice": "npm run dev -w @craftmate/voice",
    "start:ingress": "npm run start -w @craftmate/ingress",
    "dev:console": "npm run dev -w @craftmate/admin-console",
    "build": "npm run build -w @craftmate/admin-console",
    "build:console": "npm run build -w @craftmate/admin-console",
    "build:desktop": "npm run build -w @craftmate/desktop-shell",
    "db:check": "node tools/check-schema.mjs",
    "db:check:file": "node tools/check-schema.mjs .tmp-db",
    "check:bridge": "node tools/bridge-live-check.mjs",
    "test": "node --test --experimental-strip-types \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"services/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
