# Copy to .env. The real .env is ignored by Git and loaded by project startup scripts.
CRAFTMATE_MODEL_PROVIDER=deepseek
CRAFTMATE_MODEL_URL=https://api.deepseek.com/v1
CRAFTMATE_MODEL=deepseek-v4.1-flash
CRAFTMATE_MODEL_KEY=
CRAFTMATE_MODEL_TIMEOUT_MS=10000

# Doubao Seeduplex real-time speech. Keep keys in the ignored `.env`.
TTS_PRIMARY_ID=primary
TTS_PRIMARY_PROVIDER=volcengine-realtime
TTS_PRIMARY_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
TTS_PRIMARY_KEY=
TTS_PRIMARY_VOICE_ID=zh_female_vv_uranus_bigtts
TTS_PRIMARY_INSTRUCTIONS=你是软萌爱撒娇的蓝色鲸鱼娘「大肥鱼」。用清亮少女音、自然口语和一点嘴硬撒娇的语气，忠实朗读提供给你的台词，不添加、不改写台词。
TTS_SYNTHESIS_TIMEOUT_MS=300000

# Optional: when set, launcher starts Ingress. dyhub must already be running.
DOUYIN_ROOM_ID=
DYHUB_URL=ws://127.0.0.1:8757
