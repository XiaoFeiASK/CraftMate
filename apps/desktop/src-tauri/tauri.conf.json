{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftMate",
  "version": "0.1.0",
  "identifier": "dev.craftmate.console",
  "build": {
    "beforeDevCommand": "npm run dev:console --workspace-root",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:console --workspace-root",
    "frontendDist": "../../console/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CraftMate",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": []
  }
}
