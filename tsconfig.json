{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@craftmate/contracts": ["./packages/contracts/src/index.ts"],
      "@craftmate/agent": ["./packages/agent/index.ts"],
      "@craftmate/agent/application": ["./packages/agent/application/index.ts"],
      "@craftmate/agent/domain": ["./packages/agent/domain/index.ts"],
      "@craftmate/bridge": ["./packages/bridge/src/index.ts"],
    "@craftmate/local-config": ["./packages/local-config/src/index.ts"],
      "@craftmate/local-auth": ["./packages/local-auth/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "services/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
